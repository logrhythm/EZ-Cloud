  @page
    margin-top 1.5cm
    margin-bottom 1.75cm

  body
    color #000
    background #fff
    height auto
    overflow visible

  #Header
    border-bottom none

  #SubHead
    .sub-header-icon
    hr
      display none !important

  #layouts
    margin-top 2mm

  #breadcrumbs
    position absolute
    margin-top 50px

  #VolumeChartContainer
    height 260px

    svg
      margin-top 95px

  #HostHeaderDetailsContainer
    padding 5px 20px 0
    max-height 162px

  #HostCloudAIDetailsContainer
    padding 5px 20px 0

  #HostHeaderCloudAIDetails
    margin 0px auto
    width 960px
    position relative
    padding-bottom: 20px

    .host-cloudai-details
      div
        float left
        margin-left 2px

      .cloudAiLabelsContainer
        max-width 95%

      .labelsContainer
