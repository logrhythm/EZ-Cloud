      margin-right 2%
      width inherit
      overflow hidden


  #HostHeaderCloudAIDetails fieldset
    border 1px solid #3a3c3d
    line-height 1.6em
    border-radius: 5px

  #HostHeaderCloudAIDetails fieldset.activeHeader
