.open-collectors-table-grids-custom 
    position: relative;
    .load-more-agents__loader-wrapper {
        position: absolute;
        bottom: 13px;
        width: 100%;
        text-align: center;
        height: calc(100% - 94%); 
        img {
          width: 100%;
          max-width: 55px;
        }  
    }         
    .loaderWrapper
        position: absolute;
        top: 65px;
        z-index: 999;
        width: 100%;
        margin: 0 auto;
        text-align: center;
        height: calc(100% - 65px);
        color: red;
         img {
                width: 100%;
                max-width: 170px;
                top: 50%;
                position: absolute;
                left: 0;
                right: 0;
                margin: 0 auto;
                transform: translateY(-50%);
         }
.loaderWrapper__page-load {
    height: calc(100vh - 234px);
    text-align: center;
    position: relative;
    img {
        position: absolute;
        top: 50%;
        transform: translateY(-50%)
        width: 100%;
        max-width: 200px;
        margin: 0 auto;
        left: 0;
        right: 0;
    }
}  

