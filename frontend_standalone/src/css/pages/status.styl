.page-status
  height       100%

  #MainWrap
    overflow    hidden

  #MainWrapInner
    min-width   0

  .subHead .subHeadContainer
    padding     15px 0

  .Night .active-users-summary
    color       nErrorTitleColor
    text-shadow 0 0 8px nErrorTitleTs, 0 0 8px nErrorTitleTs, 0 0 8px nErrorTitleTs
  .Day .active-users-summary
    color       dErrorTitleColor
    text-shadow 0 0 8px dErrorTitleTs, 0 0 8px dErrorTitleTs, 0 0 8px dErrorTitleTs
  .active-users-summary
    min-height  35px
    margin-top  25px
    text-align  left
    font-size   30px
    titleFont()
    font-weight 200

  .last-updated
    float       right
    font-size   10px

  .active-username
    font-size   20px
    margin-left 10px

  .active-user-summary
    padding-top  8px
    font-size   14px
    margin-left 10px

  .active-user-table
    margin-top  7px

  .active-user-roles
    display     block

  .active-user-role
    color         #999 !important

  .session-header
    font-size     16px
    margin-top    14px
    margin-bottom 14px

  .session-table td
    background-color inherit !important

  .connection
    margin-bottom  8px

  .connection-referer
    font-size    16px

  .kill-session, .kill-connection
    color             #800000
    text-decoration none

  .session-id, .connection-id
    font-size     10px
    margin-bottom  8px

  .end-connection
    margin-top   -27px
    margin-left  125px
    min-width     20px
    min-height    20px

  .end-session
    margin-top    -1px
    min-width     20px
    min-height    20px

