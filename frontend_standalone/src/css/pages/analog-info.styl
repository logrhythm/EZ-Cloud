.analog-info-container
  max-width 1040px
  margin 40px
.analog-header
  border-bottom 1px solid #4c4c4c
  padding 0 3px 5px 0
.analog-title
  titleFont()
  font-weight bold
.analog-sub-title
  titleFont()
  font-weight bold
  color #44a8e0

.analog-btn
  width 155px

.Night
  .analog-sub-header-text
    color #44A8E0

.Day
  .analog-sub-header-text
    color #999

.Night, .Day // To override 'ui badge' styles on CloudAI demo page.
  .analog-header
    .badge
      position relative
      padding 4px 6px
