    background: #c7c7c7
    .sub-header-container
      .sub-header-icon, .sub-header-icon-text
        text-shadow 0 1px 0px rgba(255,255,255,0.5)

// TODO: refrence color variables once they are defined in lr-style:
.Night
  .subHead
    background: #1f2121
    .sub-header-container
      .sub-header-icon, .sub-header-icon-text
        text-shadow 0 1px 1px #000

[disabled]
  .sub-header-icon
    cursor default

.widget-filter .dashboard-filter-label
  float left
  
.widget-filter .dashboard-filter-value
  text-overflow ellipsis
  white-space nowrap
  overflow hidden
  float left
  max-width 85%
  margin 0 0 0 5px

