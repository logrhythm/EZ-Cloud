evidence-card, history-card, .evidence-card, .history-card
  display block

  .alarm-card
    width alarmCardWidth

.evidence-wrapper
  margin 3px
  padding 3px
  max-height 500px
  overflow auto

.evidence-heading
  margin-bottom: seem

.evidence-card
  img
    max-width 100%

.evidence-card-header
  border-radius 3px 3px 0 0;
  line-height 25px
  padding 0 seem

.evidence-card-body
  position relative
  padding seem

.evidence-data
  display block
  font-size 12px
  overflow hidden
  margin-bottom seem

  time
    float right
    margin-left seem

  strong
    font-size 13px
    overflow hidden

.evidence-card-file, .note-card, .evidence-card-logs
  border-radius 3px
  line-height 1.5
  font-size 12px
  position relative
  padding seem
  .truncate
    white-space nowrap
    overflow hidden
    text-overflow ellipsis

.note-card
  white-space pre-wrap
  word-wrap break-word

  ins
    text-decoration none

  del
    text-decoration none

.tag-in-history
  padding 0px 3px
  border-top-left-radius 2px
  border-bottom-left-radius 2px
  .Night &
    background linear-gradient(hsla(210,3%,29%,1), #393b3d)
    text-shadow 0 1px 1px rgba(0,0,0,0.8)
    color #ccc
  .Day &
    background linear-gradient(#d9d9d9, #adadad)
    text-shadow 0 1px 1px #fafafa
    color #3d3d3d

.evidence-card-evidence
  border-width: 0
  border-right-width: 1px
  display table-cell
  padding-right seem
  vertical-align middle
  width: 320px

.evidence-card-meta
  display table-cell
  padding-left: seem
  vertical-align middle

.evidence-comment
  margin-top 10px
  textarea
    height 24px
    resize none

.case-toolbar i
  font-size 13px
  width 27px
  cursor pointer
  padding-left 12px

.evidence
.Night
  .evidence-card
    background linear-gradient(#222, #191919)
    border 1px solid #3a3c3d
    box-shadow inset 0 1px 0 rgb(0, 0, 0, 0.3)

  .evidence-card-body
    text-shadow 0 1px 1px #000

  .evidence-data
    color: #fff

  .evidence-card-evidence
    border-image: linear-gradient( rgba(73, 74, 77, 0), rgba(73, 74, 77, 1), rgba(73, 74, 77, 0) ) 14% stretch

  .evidence-created-date
    color #c4c4c4

  .evidence-comment
    textarea
      background #0d0c0c

  .note-card
    background linear-gradient(#363738, #242424)


.Day
  .evidence-card
    background hsla(0, 0.0000%, 94.1177%, 1.0000)
    border 1px solid hsla(0, 0.0000%, 66%, 1.0000)
    box-shadow inset 0 1px 0 #fff
    color hsla(0, 0.0000%, 40.0000%, 1.0000)

  .evidence-heading
    text-shadow 0 1px 0 rgba(255,255,255, 0.5)

  .evidence-card-body
    color #444

  .evidence-card-evidence
    border-image: linear-gradient( rgba(73, 74, 77, 0), rgba(73, 74, 77, 1), rgba(73, 74, 77, 0) ) 14% stretch

  .evidence-created-date
    color #c4c4c4

  .evidence-comment
    textarea
      background #0d0c0c

.note-transporter
  width 348px
.logo-wrapper__logs 
    padding-left: 6px
