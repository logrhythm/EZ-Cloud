SELECT_WIDTH = 260px

#Terms
  width SELECT_WIDTH + 40
  margin-top 0
  padding 0
  display inline-block
  vertical-align top

#Context .SimpleSelectValue
#Context .select.value
  width 245px
  min-width @width

searchWidth = 250px
.searchPop
  position absolute
  width searchWidth + SELECT_WIDTH*2 - seem*2
  top -11px
  right -98px
  border-radius 0 0 4px 4px
  text-align left
  .SimpleSelectUL
    &.bottom-align
      bottom 28px

  .dateRangeFilter
    float left
    min-width 90px
    .simple-tooltip
      text-align center
      margin-bottom 10px
    .btn
      max-width 280px

.chzn-single
  border-radius rounded !important

.searchField, input.searchField
  display inline-block
  height 28px

.search-builder
  padding (seem / 2 - 3) seem seem
  padding-top 16px

.recent-searches
  margin-top seem
  .title
    font-weight bold
    margin seem seem 5px 0px

.simple-search
  white-space nowrap // we are guessing the width - make sure the '+' button never wraps
  margin-top (seem / 2)
  display flex

  .search-text
    line-height 28px
    display inline-block
    vertical-align top
    margin 0 4px
    flex 0 0 auto

    &:first-child
      margin-left 0

  .addFilter
    margin-top 2px
    vertical-align top

  ui-dropdown-filtered
    flex 0 0 auto

  .search-text
    flex 1 0 auto

  #Terms
    flex 1 1 100%

  .btn.addFilter
    flex 0 0 auto

.recent-searches .search-table
  .Night &
    background nRecentSearchBgColor
  .Day &
    background dRecentSearchBgColor

.timeframe-label
  margin-right 5px

#SearchDateRangeDropDown
  display inline-block

button.dateRangeModalSelect
  display inline-block
  float right

.lastTimePickerSelectContainer
  position absolute
  bottom 14px
  right 21px

.search-block
  border-radius 3px
  margin 3px 0 6px

  .header
    padding 7px 0 0 7px
    position relative

    .remove
      position absolute
      top 7px
      right 7px

  .button-row
    margin-bottom 10px

  .body
    padding 10px

  .button-footer
    padding 0 10px 10px 10px

  .mode.dropdown
  .mode .SimpleSelectValue
    min-width 5em

  .remove-group,
  .remove-filter
    width 31.5px
    padding-left 0.5rem
    padding-right 0.5rem

.search-filter
  border-radius 3px
  padding 7.5px

  .filter-dropdown-list
    .dropdown-menu
      ui-menu
        overflow auto

  .dropdown
    margin-right 3px
    min-width 10.5em
    max-width 10.5em

  .filter-type-default
    .clear
      padding-left 60px
    .typeahead
      padding-right 23px

  .kvb-selected-values
    width 22em
    max-width 22em

  .btn
    margin-top 0
    margin-bottom 0

  .kv-browse
    padding-left 4px
    padding-right 4px

  .kv-browse,
  .add-tuple
    margin-right 3px
    width 77px

  .filter-value-control
    display: flex
    flex-grow 1

    .filter-values
      margin-right 3px
      flex-grow 1

      .search-tuple + .search-tuple
        margin-top 3px

      .search-tuple
        .remove-tuple
          margin-left 3px

        .quantity-operator
          min-width 4em
          max-width 4em

        .value1:not(.textOnly), .value2
          position relative
          display inline-block
          width 7em

        .simple-tooltip
          float left
          max-width 15em
          margin-bottom .5em

.filter-cell
  float left
  flex-grow 1

  ui-dropdown-typeahead.dropdown
    min-width none
    max-width none
    width 100%

[search-criteria]
  .btn
    &.btn-active
      border 0

    .icon-x
      font-size 7px

.nixy .filter-cell .btn .icon-x:before
  left 2px

.quantity-values
  margin-left 3px

  .value1, .value2
    width 5em

[search-member]
  position relative
  margin-left 2.5em

  &::before
    position absolute
    top 0
    left 0
    margin-left - @margin-left
    line-height 2.5em
    transition left 300ms ease

// descendant selectors used to prevent cascading 'AND' since it is defined last
// Could be moved into Angular later
.any > .body > [search-member]::before
  content 'OR'
.all > .body > [search-member]::before
  content 'AND'
.search-block > .body > [search-member]:nth-child(2)::before
  left 4em

.search-block > .body > [search-member]:nth-child(2)
  margin-top 0

.search-block > .body > [search-member]
  margin-top 3px

.search-block .scrollable
  overflow-y scroll

.search-block .clipped
  overflow-y hidden
  &:after
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    z-index 9999
    text-align center
    line-height 24em
    box-sizing border-box
    content "Please increase the height of your browser window"

