/*
 * Panel style mixins for theming
 */

section-panel-style(background = #333333)
  background background
  iconColors(background)

section-panel-header-style(background = #333333, gradient = false, color = #ccc, fontWeight = normal)
  background-color background

  if gradient
    background-image linear-gradient( rgba(0, 0, 0, 0), rgba(0, 0, 0, .2) )

  border-bottom 1px solid darken(background, 20)
  box-shadow 0 1px 0 lighten(background, 20)
  color color
  font-weight fontWeight
  margin-bottom 1px

section-panel-footer-style(background = #333333)
  background-color background
  border-top 1px solid lighten(background, 20)
  box-shadow 0 -1px 0 darken(background, 20)

/*
 * End mixins
 */

.resizable-section-panel
  box-sizing border-box
  padding-bottom: 8px
  position relative

.resizable-section-panel__separated
  margin-top 10px

.resizable-section-panel__wrapper
  height 100%
  
  // resizeable content should have an overflow
  .section-panel__body
    overflow-y auto

.section-panel
  align-items stretch
  display flex
  flex-direction column
  flex-wrap nowrap
  justify-content space-between
  box-sizing border-box
  position relative
  height 100%
  width 100%

  .Night &
    section-panel-style(borderRadius: 4px 4px 0 0)

  .Night .ui.tabset &
    section-panel-style(background: #4A4A4A)

  .Day &
    section-panel-style(background: #cacaca)

  .Day .ui.tabset &
    section-panel-style(background: #E0E0E0)

.section-panel__header
  border-radius 4px 4px 0 0
  box-sizing border-box
  min-height 28px
  padding 5px

  .Night &
    section-panel-header-style()
    text-shadow nTextShadow

    .icon-user
      color #808080
      cursor pointer

      &:hover
        color #ccc

  .Night .ui.tabset &
    section-panel-header-style(background: #4A4A4A)

  .Day &
    section-panel-header-style(background: #cacaca, color: #4c4c4c)
    text-shadow dTextShadowWhite

  .Day .ui.tabset &
    section-panel-header-style(background: #E0E0E0, color: #4c4c4c)

.section-panel__body
  box-sizing border-box
  position relative
  flex 1 1

.section-panel__content
  padding 8px

.section-panel__footer
  box-sizing border-box
  display table
  table-layout fixed
  width 100%

  .Night &
    section-panel-footer-style()

  .Day &
    section-panel-footer-style(background: #cacaca)


.section-panel__footer--padded
  padding 9px
