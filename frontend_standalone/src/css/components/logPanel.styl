HEADER_HEIGHT =  32px;

.panel-header {
  @extend .vertical-align-row
  height: HEADER_HEIGHT;
  line-height: HEADER_HEIGHT;
  font-size: 12px;

  .dropdown {
    &.narrow {
      min-width: 65px;
    }
    &.compressed {
      min-width: 110px;
    }
  }

  .active-filters-icon {
    .ui.badge {
      right: -16px;
      top: -3.5px;
    }
  }

  .Night & {
    color: nMtlMtllColor;
    background: linear-gradient(nMegaTopHeadGradColorStop1, nMegaTopHeadGradColorStop2)
    border-top: 1px solid nMegaTopHeadBorder
    box-shadow: 0 3px 20px 2px rgba(black, 0.14)
  }

  .Day & {
    color: dMtlMtllColor;
    background linear-gradient(dMegaTopHeadGradColorStop1, dMegaTopHeadGradColorStop2)
    border-top 1px solid #bfbfbf
    box-shadow 0 3px 20px 2px rgba(black, 0.07)
  }

  .separator {
    border-left: none;
    height: 100%;
  }
}

.pallete-trigger {
  float: right;
  width: HEADER_HEIGHT;
}

.logs-panel-refresh {
  .logs-panel-refresh-button {
    cursor: pointer;
  }

  button:hover {
    .icon-revert {
      .Day & {
        color: gray-nero-12;
      }

      .Night & {
        color: gray-very-light-80;
      }
    }
  }
}

.logs-panel-content {
  padding-top: 8px;
}

.logs-table {
  .ui.sortable-header {
    & > i.icon-sort-asc,
    & > i.icon-sort-desc {
      margin-top: 0;
      font-size: inherit;
    }
  }
  .icon-gear {
    cursor: pointer;
    display: none;
    line-height: 22px;
  }
  .cell:hover .icon-gear,
  .selected-row .icon-gear {
    display: block;
  }

  .cell {
    height: 100%;
    display: flex;
  }

  .checked-row {
    &:before {
      content: '';
      position: absolute;
      width: 100%;
      height: 100%;
      opacity: 0.2;
      background: #007dc3;
    }
  }

  .check-all {
   .checkbox {
      bottom: 0;
      background-color: #fff;
      right: 0;
      padding: 3px 4px;
      border-top: 1px solid #ccc;
    }
  }

  .ui.table {
    &.sticky_left {
      border-right: 1px solid #666666;
      box-shadow: none;
    }
  }
}

.icon-checkbox {
  min-width: 1.4em;
}

.LogsTableContainer {
  position: relative;
}

.megagrid-loading {
  position: absolute;
  left: 16px;
  bottom: 24px;
  z-index: 2;
  background-color: #121213;
  color: #CCCCCC;
  padding: 4px 8px;
  font-size: 12px;
  line-height: 16px;
  border-radius: 2px;
}

.ui.button.backToTop {
  .icon-up {
    margin-right: 6px;
    vertical-align: middle;
  }

  position: absolute;
  right: 42px;
  bottom: 26px;
  z-index: 1;
  opacity: .98;
  transition: opacity .2s ease-in-out;

  &.hidden {
    opacity: 0;
    visibility: hidden;
  }

  &:hover {
    opacity: 1;
  }
}

.filters-inspector {
  .ui.badge {
    position: relative;
  }
}

.new-logs-banner {
  background-color #E5F2F9
  border-bottom 1px solid #C5C5C5
  padding 4px 16px 3px 16px
  width 100%
  font-size 12px
  line-height 16px
}

.load-new-logs-button {
  cursor pointer
  text-decoration underline
}

.logs-showing-count {
  padding 0 12px;
}

.widget-name {
  .Day & {
    color: #4d4d4d;
    text-shadow: 0 1px 1px rgba(255, 255, 255, 0.5);
  }
  .Night & {
    color: gray-very-light-80;
  }
  margin-right: 10px;
  margin-left: 10px;
}
