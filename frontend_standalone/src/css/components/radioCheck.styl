DISABLED_ALPHA = 0.4

.radio, .checkbox
  display inline-block
  vertical-align middle
  span, i
    vertical-align middle

  &.small
    font-size 11px
    min-width 110px
    .checkbox-label
      font-size 11px

  [type="radio"], [type="checkbox"]
    display none

  .checkbox-label [class*='icon-']
    min-width 12px
    display inline-block
    vertical-align top
    line-height normal
    margin-right 0.4rem

  [type="radio"]:checked + .radio-label,
  .radio-label.checked,
  [type="checkbox"]:checked + .checkbox-label,
  .checkbox-label.checked
    box-shadow inset 0 1px 2px rgba(black,0.5)

    .Night &
      background grey-nero-10
      nGlow()

    .Day &
      background white-smoke-98
      dGlow()

  [type="radio"]:disabled + .radio-label,
  .radio-label.disabled,
  [type="checkbox"]:disabled + .checkbox-label,
  .checkbox-label.disabled
    cursor default !important
    box-shadow none
    text-shadow none

    .Night &
      color rgba(gray-very-light-80, 0.15)
      border-color rgba(gray-bright-36, 0.3)

    .Day &
      color rgba(grey-charcoal-30, DISABLED_ALPHA)
      border-color rgba(gray-bright-36, 0.15)


  [type="radio"]:checked:disabled + .radio-label,
  .radio-label.checked.disabled,
  [type="checkbox"]:checked:disabled + .checkbox-label,
  .checkbox-label.checked.disabled

    .Night &
      background rgba(grey-nero-10, DISABLED_ALPHA)
      text-shadow none

    .Day &
      background rgba(gray-bright-36, DISABLED_ALPHA)
      text-shadow none

.radio-label, .checkbox-label
  font-size 14px
  cursor pointer
  border-radius rounded
  margin 0
  padding 4px 10px
  box-shadow 0 3px 4px -2px rgba(black,0.7)
  border 1px solid
  display inline-flex
  align-items center

  &.small
    font-size 11px
    margin 0
    padding 2px 8px

  .Night &
    border-color gray-bright-36
    background linear-gradient(gray-tuna-29, gray-montana-24)

  .Day &
    border-color gray-dark-70
    background linear-gradient(white-gainsboro-85, gray-dark-70)
