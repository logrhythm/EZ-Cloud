.beats {
  .palette-content {
      padding: 0px;
  }
  .palette-main {
      border: none !important;
      padding-right: 8px;
  }
} 

.disable-lebel{
  opacity: 0.3
}

// Inspector loader styles
.oc-screen {
  .inspectorLoader{
    height: 100%;
    position: absolute;
    z-index: 9999;
    background: #333333;
    width: 100%;
  }
}

.inspectorLoader{
  height: 100%;
  .inspectorLoaderWrapper{
    top: 45%;
    position: relative;
    transform: translateY(-50%);
    max-width: 200px;
    margin: 0 auto;
    left: 15%;
  }
}

// Spinner animation
.spinner-loader {
  position: fixed;
  top: 50%;
  transform: translate(-50%, -50%);
  border: 4px solid #82cee9;
  border-top: 4px solid #02b7fe; 
  border-radius: 50%;
  width: 50px;
  height: 50px;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

// Dashboard popup styles
.dashboard-popup .modal-header{
  display: none;
}

.dashboard-popup{
  .dx-pop-up-header{
    display: flex;
    align-items: center;
    p{
      font-size: 18px;
      text-align: center;
      padding-top: 2rem; 
      padding-bottom: 1rem; 
      width: 100%;
    }
    .dx-close-icon{
      font-size: 25px; 
      font-weight: 800; 
      margin-right: 1rem;
      margin-bottom: 3rem; 
      cursor: pointer;
    }
  }
  .pop-up-body{
    display: flex; 
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    text-align: center; 
    margin: 20px;
    .event-body{
      width: 28rem;
      margin-right: 1rem; 
      height: 26rem; 
      border: 1px solid;
      border-radius: 10px; 
      padding: 3.5rem;
      .event-body-text{
        height: 16rem
      }
    }
    .dx-body{
      width: 28rem; 
      height: 26rem; 
      border: solid 1px; 
      border-radius: 10px;
      padding: 3.5rem;
      .dx-body-text{
        height: 16rem
      }
    }
  }
}

// Button styles based on reference images
.ui.button {
  border-radius: 3px;
  font-weight: 500;
  transition: background-color 0.3s ease, box-shadow 0.3s ease;
}

.Night {
  .ui.button.primary {
    background-color: #02b7fe;
    color: #000000;
    border: none;
    &:hover {
      background-color: lighten(#02b7fe, 10%);
      box-shadow: 0 0 5px rgba(2, 183, 254, 0.5);
    }
  }
  
  .ui.button.secondary {
    background-color: #3a3c3d;
    color: #cccccc;
    border: 1px solid #494b4d;
    &:hover {
      background-color: #494b4d;
    }
  }
}

.Day {
  .ui.button.primary {
    background-color: #007bc2;
    color: #ffffff;
    border: none;
    &:hover {
      background-color: darken(#007bc2, 5%);
    }
  }
  
  .ui.button.secondary {
    background-color: #e0e0e0;
    color: #333333;
    border: 1px solid #cccccc;
    &:hover {
      background-color: #f0f0f0;
    }
  }
}

// Input styling
.Night {
  input[type="text"], input[type="password"], input[type="search"], textarea, select {
    background: #262626;
    border: 1px solid #3d3d3d;
    color: #cccccc;
    &:focus {
      border-color: #02b7fe;
      box-shadow: 0 0 5px rgba(2, 183, 254, 0.3);
    }
  }
}

.Day {
  input[type="text"], input[type="password"], input[type="search"], textarea, select {
    background: #ffffff;
    border: 1px solid #cccccc;
    color: #333333;
    &:focus {
      border-color: #007bc2;
      box-shadow: 0 0 5px rgba(0, 123, 194, 0.3);
    }
  }
}

// Inspector panel styling based on the reference images
.inspector-pane {
  border-radius: 3px;
  overflow: hidden;
  
  .inspector-header {
    padding: 10px;
    font-weight: bold;
    font-size: 16px;
  }
  
  .tab-content {
    padding: 15px;
  }
}

.Night {
  .inspector-pane {
    background: #2c2c2c;
    border: 1px solid #3d3d3d;
    
    .inspector-header {
      background: #3d3d3d;
      color: #cccccc;
    }
  }
}

.Day {
  .inspector-pane {
    background: #f5f5f5;
    border: 1px solid #d8d8d8;
    
    .inspector-header {
      background: #e6e6e6;
      color: #333333;
    }
  }
}

// Tab styling
.ui.tabset {
  .tabs {
    display: flex;
    border-bottom: 1px solid;
    
    .tab {
      padding: 10px 15px;
      cursor: pointer;
      transition: background-color 0.2s ease;
      border-bottom: 2px solid transparent;
      
      &.active {
        border-bottom: 2px solid;
      }
    }
  }
}

.Night {
  .ui.tabset {
    .tabs {
      border-bottom-color: #3d3d3d;
      
      .tab {
        color: #a0a0a0;
        
        &:hover {
          background-color: #3a3c3d;
        }
        
        &.active {
          color: #02b7fe;
          border-bottom-color: #02b7fe;
        }
      }
    }
  }
}

.Day {
  .ui.tabset {
    .tabs {
      border-bottom-color: #d8d8d8;
      
      .tab {
        color: #666666;
        
        &:hover {
          background-color: #f0f0f0;
        }
        
        &.active {
          color: #007bc2;
          border-bottom-color: #007bc2;
        }
      }
    }
  }
}

// Search controls based on reference images
.search-controls {
  display: flex;
  align-items: center;
  gap: 10px;
  
  .search-field {
    flex-grow: 1;
    position: relative;
    
    input {
      width: 100%;
      padding: 8px 10px;
      border-radius: 3px;
    }
  }
  
  .search-button {
    min-width: 80px;
    text-align: center;
    font-weight: bold;
  }
}

.Night {
  .search-button {
    background: #02b7fe;
    color: #000000;
    &:hover {
      background: lighten(#02b7fe, 10%);
    }
  }
}

.Day {
  .search-button {
    background: #007bc2;
    color: #ffffff;
    &:hover {
      background: darken(#007bc2, 5%);
    }
  }
}